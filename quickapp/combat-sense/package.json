{
  "name": "combat-sense",
  "version": "1.0.0",
  "description": "CombatSense Edge - Boxing training assistant for openvela wearable",
  "engines": {
    "node": ">=8.10"
  },
  "scripts": {
    "start": "aiot start --disableNSH",
    "build": "aiot build",
    "release": "aiot release",
    "watch": "aiot start --watch --disableNSH",
    "simulator:init": "aiot initEmulatorEnv",
    "simulator:create-vvd": "node scripts/create-velasim-vvd.js",
    "simulator:headless": "xvfb-run -a -s '-screen 0 1024x768x24' aiot start --disableNSH",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/"
  },
  "devDependencies": {
    "@aiot-toolkit/velasim": "^0.1.26",
    "aiot-toolkit": "2.0.5",
    "@aiot-toolkit/jsc": "^1.0.8",
    "babel-eslint": "^10.0.1",
    "eslint": "^6.0.0",
    "eslint-plugin-ux": "^0.0.4"
  }
}
