  font-size: 18px;
  color: #888888;
  margin-right: 8px;
}
.conf-track {
  width: 200px;
  height: 8px;
  background-color: #333333;
  border-radius: 4px;
}
.conf-fill {
  height: 8px;
  background-color: #34d399;
  border-radius: 4px;
}
.conf-value {
  font-size: 18px;
  color: #34d399;
  margin-left: 8px;
}
.total-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 16px;
}
.total-label {
  font-size: 20px;
