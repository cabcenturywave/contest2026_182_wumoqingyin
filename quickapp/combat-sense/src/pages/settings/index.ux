.page {
  flex-direction: column;
  align-items: center;
  width: 480px;
  height: 480px;
  background-color: #0a0a0a;
}
.header {
  margin-top: 30px;
  margin-bottom: 16px;
}
.header-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.back-btn {
  margin-right: 20px;
  padding: 8px;
}
.back-icon {
  font-size: 28px;
  color: #888888;
}
.title {
  font-size: 28px;
  color: #ffffff;
  font-weight: bold;
}
.list {
  flex-direction: column;
  width: 380px;
}
.list-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 60px;
  padding: 0 16px;
  border-bottom-width: 1px;
  border-bottom-color: #222222;
}
.item-label {
  font-size: 22px;
  color: #cccccc;
}
.item-value {
  font-size: 20px;
  color: #ffffff;
}
.val-on {
  color: #34d399;
}
.val-off {
  color: #ff4444;
}
.footer {
  flex-direction: column;
  align-items: center;
  margin-top: 40px;
}
.footer-text {
  font-size: 16px;
  color: #555555;
}
.footer-sub {
  font-size: 14px;
  color: #444444;
  margin-top: 4px;
}
</style>
