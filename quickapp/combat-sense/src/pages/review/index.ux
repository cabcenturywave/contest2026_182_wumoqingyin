<template>
  <div class="page">
    <div class="demo-banner" if="{{ !isRealSession }}">
      <text class="demo-banner-text">演示数据，非真实训练</text>
    </div>
    <div class="real-banner" if="{{ isRealSession && dataSource === 'hardware' }}">
      <text class="real-banner-text">真机传感器训练回顾</text>
    </div>
    <div class="demo-session-banner" if="{{ isRealSession && dataSource !== 'hardware' }}">
      <text class="demo-session-banner-text">本次训练使用演示事件，非真机采集</text>
    </div>
    <div class="header">
      <text class="title">训练回顾</text>
    </div>

    <div class="duration-section">
      <text class="duration-value">{{ durationDisplay }}</text>
      <text class="duration-label">训练时长</text>
    </div>

    <div class="stats-grid">
      <div class="stat-item">
        <text class="stat-value stat-jab">{{ jab }}</text>
        <text class="stat-label">Jab</text>
      </div>
      <div class="stat-item">
        <text class="stat-value stat-cross">{{ cross }}</text>
        <text class="stat-label">Cross</text>
      </div>
      <div class="stat-item">
        <text class="stat-value stat-hook">{{ hook }}</text>
        <text class="stat-label">Hook</text>
      </div>
      <div class="stat-item">
        <text class="stat-value stat-other">{{ other }}</text>
        <text class="stat-label">Other</text>
      </div>
    </div>

    <div class="total-line">
      <text class="total-label">总出拳</text>
      <text class="total-value">{{ total }}</text>
      <text class="total-conf">置信度 {{ confidence }}%</text>
    </div>

    <div class="hand-section">
      <text class="section-title">左右手差异</text>
      <div if="{{ handNotCaptured }}">
        <text class="not-captured-text">本次未采集，待真机校准</text>
      </div>
      <div if="{{ !handNotCaptured }}">
        <div class="hand-bar-container">
          <div class="hand-bar-left" style="width: {{ leftBarWidth }}px;"></div>
          <div class="hand-bar-right" style="width: {{ rightBarWidth }}px;"></div>
        </div>
        <div class="hand-labels">
          <text class="hand-label-left">左手 {{ leftPct }}%</text>
          <text class="hand-label-right">右手 {{ rightPct }}%</text>
        </div>
      </div>
    </div>

    <div class="fatigue-section">
      <text class="section-title">疲劳趋势</text>
      <div if="{{ fatigueNotCaptured }}">
        <text class="not-captured-text">本次未采集，待真机校准</text>
      </div>
      <div if="{{ !fatigueNotCaptured }}">
        <div class="fatigue-bars">
          <div class="fatigue-bar" for="{{ fatigueData }}" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div>
        </div>
        <div class="fatigue-labels">
          <text class="fl">R1</text>
          <text class="fl">R2</text>
          <text class="fl">R3</text>
        </div>
      </div>
    </div>

    <div class="coach-section">
      <text class="section-title">教练建议</text>
      <div if="{{ coachNotCaptured }}">
        <text class="not-captured-text">本次未采集，待真机校准</text>
      </div>
      <div if="{{ !coachNotCaptured }}">
        <text class="coach-text" for="{{ coachTips }}">{{ $item }}</text>
      </div>
    </div>

    <div class="back-btn" onclick="goBack">
      <text class="back-text">返回首页</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router';
import dataInterface from '../../common/data-interface';

export default {
  private: {
    isRealSession: false,   // true when reached from a real user session (not standalone demo access)
    isDemoMode: true,       // true when dataSource is 'demo' (session used demo events, not hardware)
    sessionId: '',
    dataSource: 'demo',
    duration: 0,
    jab: 0,
    cross: 0,
    hook: 0,
    other: 0,
    total: 0,
    confidence: 0,
    round: 1,
    durationDisplay: '00:00',
    leftPct: 0,
    rightPct: 0,
    leftBarWidth: 0,
    rightBarWidth: 0,
    fatigueData: [],
    coachTips: [],
    handNotCaptured: true,
    fatigueNotCaptured: true,
    coachNotCaptured: true
  },
  onInit() {
    var params = this.$page.$params;
    if (params && params.sessionId && String(params.sessionId).indexOf('session_') === 0) {
      this.sessionId = params.sessionId;
      this.dataSource = params.dataSource === 'hardware' ? 'hardware' : 'demo';
      this.isRealSession = true;
      this.isDemoMode = false;
      this.duration = Number(params.duration) || 0;
      this.jab = Number(params.jab) || 0;
      this.cross = Number(params.cross) || 0;
      this.hook = Number(params.hook) || 0;
      this.other = Number(params.other) || 0;
      this.total = Number(params.total) || 0;
      this.confidence = Number(params.confidence) || 0;
      this.round = Number(params.round) || 1;
      var m = Math.floor(this.duration / 60);
      var s = this.duration % 60;
      this.durationDisplay = (m < 10 ? '0' + m : '' + m) + ':' + (s < 10 ? '0' + s : '' + s);
      this.handNotCaptured = true;
      this.fatigueNotCaptured = true;
      this.coachNotCaptured = true;
    } else {
      this.initFromDemo();
    }
  },
  initFromDemo() {
    this.isRealSession = false;
    this.isDemoMode = true;
    this.handNotCaptured = false;
    this.fatigueNotCaptured = false;
    this.coachNotCaptured = false;
    var s = dataInterface.getSessionSummary();
    this.duration = s.durationSec;
    this.jab = s.punchCounts.jab;
    this.cross = s.punchCounts.cross;
    this.hook = s.punchCounts.hook;
    this.other = s.punchCounts.other;
    this.total = s.totalPunches;

    var m = Math.floor(s.durationSec / 60);
    var sec = s.durationSec % 60;
    this.durationDisplay = (m < 10 ? '0' + m : '' + m) + ':' + (sec < 10 ? '0' + sec : '' + sec);

    var l = s.handDistribution.left;
    var r = s.handDistribution.right;
    var hTotal = l + r;
    if (hTotal > 0) {
      this.leftPct = Math.round(l / hTotal * 100);
      this.rightPct = 100 - this.leftPct;
      this.leftBarWidth = Math.round(l / hTotal * 300);
      this.rightBarWidth = 300 - this.leftBarWidth;
    }

    var rounds = s.roundBreakdown;
    var sumConf = 0;
    var fatigue = [];
    for (var i = 0; i < rounds.length; i++) {
      sumConf += rounds[i].avgConfidence;
      var rate = rounds[i].peakPunchesPerMin;
      var h = Math.max(10, Math.round(rate / 55 * 40));
      var c = rate > 45 ? '#4fc3f7' : rate > 35 ? '#ff9800' : '#ff4444';
      fatigue.push({ height: h, color: c });
    }
    this.confidence = Math.round(sumConf / rounds.length * 100);
    this.fatigueData = fatigue;
    this.coachTips = s.coachSuggestions;
  },
  goBack() {
    router.replace({ uri: '/pages/index' });
  }
};
</script>

