<template>
  <div class="page">
    <div class="header">
      <div class="header-row">
        <text class="title">CombatSense</text>
        <div class="settings-btn" onclick="goSettings">
          <text class="settings-icon">⚙</text>
        </div>
      </div>
      <text class="subtitle">Edge</text>
    </div>

    <div class="status-bar">
      <div class="status-dot {{ deviceConnected ? 'dot-on' : 'dot-off' }}"></div>
      <text class="status-text">{{ deviceStatus }}</text>
    </div>

    <div class="summary-card" if="{{ hasLastSession }}">
      <text class="card-label">上次训练</text>
      <div class="summary-row">
        <div class="summary-item">
          <text class="summary-value">{{ lastDuration }}</text>
          <text class="summary-unit">分钟</text>
        </div>
        <div class="summary-item">
          <text class="summary-value">{{ lastPunches }}</text>
          <text class="summary-unit">出拳</text>
        </div>
        <div class="summary-item">
          <text class="summary-value">{{ lastConfidence }}%</text>
          <text class="summary-unit">置信度</text>
        </div>
      </div>
    </div>

    <div class="summary-card" if="{{ !hasLastSession }}">
      <text class="card-label">尚无训练记录</text>
      <text class="card-hint">开始你的第一次训练吧</text>
    </div>

    <div class="start-btn" onclick="goSession">
      <text class="start-text">开始训练</text>
    </div>

    <div class="nav-hint">
      <text class="hint-text">上滑查看更多</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router';
import dataInterface from '../../common/data-interface';

export default {
  private: {
    deviceConnected: true,
    deviceStatus: '传感器就绪',
    hasLastSession: true,
    lastDuration: '3.0',
    lastPunches: '117',
    lastConfidence: '84'
  },
  onReady() {
    var self = this;
    dataInterface.probeSensor(
      function () {
        self.deviceConnected = true;
        self.deviceStatus = '传感器就绪';
      },
      function () {
        self.deviceConnected = false;
        self.deviceStatus = '传感器不可用 — 使用 Demo 数据';
      }
    );

    var session = dataInterface.getSessionSummary();
    if (session) {
      self.hasLastSession = true;
      self.lastDuration = (session.durationSec / 60).toFixed(1);
      self.lastPunches = String(session.totalPunches);
      var avg = 0;
      if (session.roundBreakdown && session.roundBreakdown.length > 0) {
        var sum = 0;
        for (var i = 0; i < session.roundBreakdown.length; i++) {
          sum += session.roundBreakdown[i].avgConfidence;
        }
        avg = Math.round((sum / session.roundBreakdown.length) * 100);
      }
      self.lastConfidence = String(avg);
    }
  },
  goSession() {
    router.push({ uri: '/pages/session' });
  },
  goSettings() {
    router.push({ uri: '/pages/settings' });
  }
};
</script>

